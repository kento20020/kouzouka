{
  "name": "kouzouka",
  "version": "1.0.0",
  "private": true,
  "description": "要件定義から設計へ、解像度を1段ずつ上げて「状態×イベント」の全マスを埋めるための学習ノートとサンプル",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"examples/**/*.test.ts\" \"app/test/*.test.mjs\"",
    "typecheck": "tsc",
    "spec": "node examples/send-to-ai/spec-cli.ts > examples/send-to-ai/SPEC.md",
    "app:build": "node app/build.mjs",
    "check": "npm run typecheck && npm run app:build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^6.0.2"
  }
}
